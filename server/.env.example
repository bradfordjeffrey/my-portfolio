# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# Site(s) allowed to call the API (comma-separated). Use your real domain in production.
CLIENT_ORIGIN=http://localhost:5173

# SMTP settings for sending contact-form emails.
# If these are left empty, messages are printed to the server console instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Google "App Password", not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where contact messages are delivered (defaults to SMTP_USER).
CONTACT_TO_EMAIL=
